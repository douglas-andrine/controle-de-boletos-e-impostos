generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// O banco guarda só PENDENTE/PAGO; ATRASADO é derivado da data de vencimento.
enum PaymentStatus {
  PENDENTE
  PAGO
}

// ADMIN pode criar outros usuários com email e senha
enum UserRole {
  USER
  ADMIN
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

model User {
  id           String       @id @default(cuid())
  name         String
  email        String       @unique
  passwordHash String? // null para quem entrou só via Google
  googleId     String?      @unique
  provider     AuthProvider @default(LOCAL)
  role         UserRole     @default(USER)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  suppliers Supplier[]
  taxes     Tax[]
  boletos   Boleto[]

  @@map("users")
}

model Supplier {
  id        String   @id @default(cuid())
  userId    String
  // O cadastro pede só nome fantasia e categoria; os outros campos ficam de registros antigos
  legalName String? // Razão Social
  tradeName String? // Nome Fantasia (obrigatório na API; nulo só em registros antigos)
  document  String? // CPF/CNPJ só dígitos
  email     String?
  phone     String?
  category  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  boletos Boleto[]
  taxes   Tax[]

  @@unique([userId, document])
  @@index([userId, tradeName])
  @@map("suppliers")
}

model Tax {
  id             String        @id @default(cuid())
  userId         String
  name           String // DARF, DAS, IPTU...
  revenueCode    String?
  amountCents    Int
  dueDate        DateTime      @db.Date
  referenceMonth DateTime      @db.Date // período de apuração (sempre dia 1)
  paymentCode    String? // linha digitável / PIX copia e cola
  status         PaymentStatus @default(PENDENTE)
  paidAt         DateTime?
  receiptPath    String? // caminho do comprovante no storage
  invoiceNumber  String? // número da nota fiscal
  supplierId     String? // empresa do imposto
  goodsDelivered Boolean? // mercadoria entregue; null = não se aplica
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Restrict: fornecedor com impostos não pode ser excluído (preserva histórico)
  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  // Nota fiscal não se repete entre os impostos do usuário; NULL (sem nota) pode repetir
  @@unique([userId, invoiceNumber])
  @@index([userId, dueDate])
  @@index([userId, referenceMonth])
  @@index([supplierId])
  @@map("taxes")
}

model Boleto {
  id             String        @id @default(cuid())
  userId         String
  supplierId     String
  invoiceNumber  String? // nota fiscal do boleto (opcional)
  // Descrição, juros, emissão e linha digitável saíram do cadastro e ficam de registros antigos
  description    String?
  amountCents    Int
  feesCents      Int           @default(0) // juros/multa
  issueDate      DateTime?     @db.Date
  dueDate        DateTime      @db.Date
  barcode        String?
  status         PaymentStatus @default(PENDENTE)
  paidAt         DateTime?
  receiptPath    String?
  boletoReceived Boolean       @default(true) // o fornecedor mandou o boleto com a nota; false = buscar no portal
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Restrict: fornecedor com boletos não pode ser excluído (preserva histórico)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  @@index([userId, dueDate])
  @@index([supplierId])
  @@map("boletos")
}
