# Local: banco do docker-compose (pnpm db:up)
# Supabase: DATABASE_URL = pooler (porta 6543, ?pgbouncer=true), DIRECT_URL = conexão direta (porta 5432)
DATABASE_URL="postgresql://tributo:tributo@localhost:5434/tributoleao?schema=public"
DIRECT_URL="postgresql://tributo:tributo@localhost:5434/tributoleao?schema=public"

PORT=3333
WEB_ORIGIN="http://localhost:5173"

# Gere um valor aleatório: openssl rand -base64 48
JWT_SECRET="troque-por-um-segredo-aleatorio-com-32-ou-mais-caracteres"
